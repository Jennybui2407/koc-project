{
  "name": "koc-automation",
  "version": "1.0.0",
  "description": "KOC Campaign Automation System - Google Drive, Sheets, Docs & Social Media Metric Scrapers",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "cron": "tsx src/jobs/scheduler.ts",
    "sync": "tsx src/cli/run-sync.ts",
    "sync:force": "tsx src/cli/run-sync.ts --all",
    "export": "tsx src/cli/run-export.ts",
    "audit": "node scripts/koc_audit.mjs"
  },
  "keywords": [
