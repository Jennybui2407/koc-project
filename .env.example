# Default Finder Name for TikTok KOC Audit (Col B - Người phụ trách)
KOC_FINDER_NAME=Thuận

# Google Workspace Credentials Paths (Optional - defaults to ~/.config/google-drive-mcp/)
# GOOGLE_OAUTH_PATH=~/.config/google-drive-mcp/gcp-oauth.keys.json
# GOOGLE_TOKENS_PATH=~/.config/google-drive-mcp/tokens.json

# Google Sheet Configuration
SPREADSHEET_ID=1-gMFNOq7Z0XXEjC3bXN41XMUNDGW0teC5xGmRizQfgE
TRACKING_SHEET_NAME=Tracking KOC
METRICS_SHEET_NAME=Metrics Tracking

# Automation Interval (Default: Every 1 hour)
CRON_SCHEDULE=0 * * * *

# Scraper Settings
REQUEST_TIMEOUT_MS=15000

# Facebook Cookie - Cách lấy:
# 1. Mở Chrome → vào facebook.com (đã đăng nhập)
# 2. F12 → Application → Cookies → https://www.facebook.com
# 3. Tìm cookie tên "c_user" → copy Value
# 4. Tìm cookie tên "xs" → copy Value (giữ nguyên URL-encoded)
FB_C_USER=your_facebook_user_id
FB_XS=your_facebook_xs_cookie_value
